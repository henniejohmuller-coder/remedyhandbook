{
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**.apk"],
    "rewrites": [
      {"source": "/download", "destination": "/download.html"},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}]
      }
    ]
  }
}
